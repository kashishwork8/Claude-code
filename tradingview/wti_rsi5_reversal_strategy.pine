//@version=6
// =====================================================================================
// CFI WTI 1H · RSI(5) Candlestick Reversal — STRATEGY (backtest)
// -------------------------------------------------------------------------------------
// * Same signal engine as the indicator (the "SHARED SIGNAL ENGINE" block is identical).
// * Orders are market orders sent at the signal candle's close and filled by TradingView's
//   broker emulator at the NEXT candle's open (+ slippage), not at the signal close.
// * Initial capital, commission and slippage defaults below can be changed in
//   Settings -> Properties. Educational tool; a backtest does not guarantee future results.
// =====================================================================================
strategy("CFI WTI 1H RSI(5) Candlestick Reversal - Strategy", shorttitle = "WTI RSI5 Rev Strat", overlay = true, initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0, commission_type = strategy.commission.percent, commission_value = 0.0, slippage = 3, calc_on_every_tick = false, process_orders_on_close = false, max_labels_count = 500, max_boxes_count = 500)

// =====================================================================================
// SHARED SIGNAL ENGINE  —  this whole section is byte-for-byte identical in the
// indicator and the strategy, so both produce the same BUY/SELL signals.
// =====================================================================================

// ---------- Option strings (used as dropdown values; do not edit casually) ----------
string RSI_READING   = "Threshold reading (RSI <= OS / RSI >= OB)"
string RSI_CROSS     = "Fresh cross into the zone"
string TIMING_WINDOW = "RSI event within lookback window"
string TIMING_SAME   = "RSI condition on pattern-completion candle only"
string TOL_ATR       = "ATR multiple"
string TOL_TICKS     = "Ticks (x syminfo.mintick)"
string CONF_STRICT   = "Candle in signal colour closing beyond doji high/low"
string CONF_ANY      = "Any candle closing beyond doji high/low"
string CONF_MID      = "Candle in signal colour closing beyond doji midpoint"
string CONFLICT_SKIP = "Skip both"
string CONFLICT_BUY  = "Prefer BUY"
string CONFLICT_SELL = "Prefer SELL"

// ---------- 1. Chart, symbol & timeframe ----------
string G_TF = "1. Chart, symbol & timeframe"
bool   restrictTo1H   = input.bool(true, "Generate signals only on a 1-hour chart", group = G_TF, tooltip = "If ticked, no signals or alerts are produced on any other timeframe and a warning is shown.")
string expectedPrefix = input.string("CFI", "Expected broker prefix (warning only)", group = G_TF, tooltip = "Compared with syminfo.prefix (the part before ':' in the symbol). Leave empty to disable the check. It never changes the signals.")
bool   showInfoPanel  = input.bool(true, "Show info / warning panel", group = G_TF)

// ---------- 2. RSI ----------
string G_RSI = "2. RSI"
float  rsiSrc        = input.source(close, "RSI source", group = G_RSI)
int    rsiLen        = input.int(5, "RSI length", minval = 1, group = G_RSI)
float  osLevel       = input.float(20.0, "Oversold threshold", minval = 0, maxval = 100, step = 1, group = G_RSI)
float  obLevel       = input.float(80.0, "Overbought threshold", minval = 0, maxval = 100, step = 1, group = G_RSI)
string rsiEventMode  = input.string(RSI_READING, "RSI event definition", options = [RSI_READING, RSI_CROSS], group = G_RSI, tooltip = "Reading: every completed bar with RSI <= OS (or >= OB) is an event. Cross: only the bar on which RSI enters the zone is an event.")
string rsiTiming     = input.string(TIMING_WINDOW, "RSI timing vs. pattern", options = [TIMING_WINDOW, TIMING_SAME], group = G_RSI)
int    rsiLookback   = input.int(3, "RSI lookback (bars before the pattern-completion candle)", minval = 0, maxval = 50, group = G_RSI, tooltip = "An RSI event stays eligible on its own bar and for this many further completed bars. 3 = the pattern-completion candle or any of the 3 candles before it.")
bool   rsiExitFilter = input.bool(false, "Optional: RSI must be back inside the OS/OB band on the signal candle", group = G_RSI)
bool   onePerEpisode = input.bool(true, "One signal per oversold / overbought episode", group = G_RSI, tooltip = "An episode starts when RSI enters the zone. After a BUY (SELL) fires, a new BUY (SELL) needs a new oversold (overbought) episode.")

// ---------- 3. Trend context ----------
string G_TR = "3. Trend context"
int  trendLen          = input.int(3, "Price-action trend lookback (bars)", minval = 1, maxval = 50, group = G_TR, tooltip = "Downtrend: close < close N bars earlier AND the lowest low of the last N bars < the low N bars earlier. Uptrend is the mirror. Measured on the candle just before the pattern's first candle.")
bool useEma            = input.bool(false, "Add EMA filter to the trend definition", group = G_TR, tooltip = "Downtrend additionally needs close < EMA, uptrend close > EMA. Fewer, more trend-aligned signals.")
int  emaLen            = input.int(50, "EMA length", minval = 1, group = G_TR)
bool trendForAll       = input.bool(true, "Require prior trend for every pattern", group = G_TR, tooltip = "Hammer, hanging man, shooting star, inverted hammer and dojis ALWAYS need the prior trend (it is part of their definition). This switch adds the same requirement to engulfing, harami, stars, piercing/dark cloud, tweezers, pin bars, soldiers/crows and three inside/outside.")
bool showEma           = input.bool(true, "Plot the EMA when the EMA filter is on", group = G_TR)
bool showTrendBg       = input.bool(false, "Shade background by trend state", group = G_TR)

// ---------- 4. Candle geometry ----------
string G_GEO = "4. Candle geometry"
int   atrLen         = input.int(14, "ATR length", minval = 1, group = G_GEO)
int   bodyAvgLen     = input.int(14, "Average-body length (for long/small bodies)", minval = 1, group = G_GEO)
float longBodyMult   = input.float(1.0, "Long body >= x average body", minval = 0, step = 0.1, group = G_GEO)
float smallBodyMult  = input.float(0.5, "Small body <= x average body", minval = 0, step = 0.1, group = G_GEO)
float dojiBodyPct    = input.float(10.0, "Doji: body <= % of range", minval = 0, maxval = 100, step = 1, group = G_GEO)
float djOppMaxPct    = input.float(10.0, "Dragonfly/gravestone: short wick <= % of range", minval = 0, maxval = 100, step = 1, group = G_GEO)
float djLongMinPct   = input.float(60.0, "Dragonfly/gravestone: long wick >= % of range", minval = 0, maxval = 100, step = 1, group = G_GEO)
float hamLongMult    = input.float(2.0, "Hammer family: long wick >= x body", minval = 0, step = 0.1, group = G_GEO)
float hamShortMult   = input.float(0.5, "Hammer family: short wick <= x body", minval = 0, step = 0.1, group = G_GEO)
float pinNosePct     = input.float(66.0, "Pin bar: nose wick >= % of range", minval = 0, maxval = 100, step = 1, group = G_GEO)
float pinBodyPct     = input.float(33.0, "Pin bar: body <= % of range", minval = 0, maxval = 100, step = 1, group = G_GEO)
bool  pinProtrude    = input.bool(true, "Pin bar: nose must exceed previous candle's low/high", group = G_GEO)
float haramiMaxRatio = input.float(0.5, "Harami: inside body <= x mother body", minval = 0, maxval = 1, step = 0.05, group = G_GEO)
float piercePct      = input.float(50.0, "Piercing / dark cloud: penetration >= % of prior body", minval = 0, maxval = 100, step = 5, group = G_GEO)
float soldierBodyPct = input.float(50.0, "Soldiers / crows: body >= % of range", minval = 0, maxval = 100, step = 5, group = G_GEO)
float soldierWickPct = input.float(30.0, "Soldiers / crows: closing-side wick <= % of range", minval = 0, maxval = 100, step = 5, group = G_GEO)
string tolMethod     = input.string(TOL_ATR, "Tweezer tolerance method", options = [TOL_ATR, TOL_TICKS], group = G_GEO)
float tweezerAtrMult = input.float(0.05, "Tweezer tolerance: x ATR", minval = 0, step = 0.01, group = G_GEO)
int   tweezerTicks   = input.int(5, "Tweezer tolerance: ticks", minval = 0, group = G_GEO)
float minRangeAtr    = input.float(0.0, "Min range of single-candle patterns (x ATR, 0 = off)", minval = 0, step = 0.05, group = G_GEO)

// ---------- 5. Pattern switches (left = bullish, right = bearish) ----------
string G_PAT = "5. Patterns (left = bullish | right = bearish)"
bool enHammer      = input.bool(true, "Hammer", inline = "p01", group = G_PAT)
bool enShooting    = input.bool(true, "Shooting star", inline = "p01", group = G_PAT)
bool enDragonfly   = input.bool(true, "Dragonfly doji", inline = "p02", group = G_PAT)
bool enGravestone  = input.bool(true, "Gravestone doji", inline = "p02", group = G_PAT)
bool enDojiBull    = input.bool(true, "Standard doji (bull)", inline = "p03", group = G_PAT)
bool enDojiBear    = input.bool(true, "Standard doji (bear)", inline = "p03", group = G_PAT)
bool enBullEngulf  = input.bool(true, "Bullish engulfing", inline = "p04", group = G_PAT)
bool enBearEngulf  = input.bool(true, "Bearish engulfing", inline = "p04", group = G_PAT)
bool enTweezerBot  = input.bool(true, "Tweezer bottom", inline = "p05", group = G_PAT)
bool enTweezerTop  = input.bool(true, "Tweezer top", inline = "p05", group = G_PAT)
bool enMorningStar = input.bool(true, "Morning star", inline = "p06", group = G_PAT)
bool enEveningStar = input.bool(true, "Evening star", inline = "p06", group = G_PAT)
bool enPiercing    = input.bool(true, "Piercing line", inline = "p07", group = G_PAT)
bool enDarkCloud   = input.bool(true, "Dark cloud cover", inline = "p07", group = G_PAT)
bool enBullHarami  = input.bool(true, "Bullish harami", inline = "p08", group = G_PAT)
bool enBearHarami  = input.bool(true, "Bearish harami", inline = "p08", group = G_PAT)
bool enInvHammer   = input.bool(true, "Inverted hammer", inline = "p09", group = G_PAT)
bool enHangingMan  = input.bool(true, "Hanging man", inline = "p09", group = G_PAT)
bool enSoldiers    = input.bool(true, "Three white soldiers", inline = "p10", group = G_PAT)
bool enCrows       = input.bool(true, "Three black crows", inline = "p10", group = G_PAT)
bool enBullPin     = input.bool(true, "Bullish pin bar", inline = "p11", group = G_PAT)
bool enBearPin     = input.bool(true, "Bearish pin bar", inline = "p11", group = G_PAT)
bool enThreeInUp   = input.bool(true, "Three inside up", inline = "p12", group = G_PAT)
bool enThreeInDn   = input.bool(true, "Three inside down", inline = "p12", group = G_PAT)
bool enThreeOutUp  = input.bool(true, "Three outside up", inline = "p13", group = G_PAT)
bool enThreeOutDn  = input.bool(true, "Three outside down", inline = "p13", group = G_PAT)

// ---------- 6. Doji confirmation ----------
string G_DJ = "6. Doji confirmation"
string dojiConfRule   = input.string(CONF_STRICT, "Confirmation rule", options = [CONF_STRICT, CONF_ANY, CONF_MID], group = G_DJ, tooltip = "Default BUY: a bullish candle (close > open) that closes above the doji high. SELL is the mirror (bearish candle closing below the doji low).")
int    dojiExpiry     = input.int(1, "Bars allowed for confirmation", minval = 1, maxval = 10, group = G_DJ, tooltip = "1 = only the very next completed candle may confirm; otherwise the setup is cancelled.")
bool   dojiCancelBrk  = input.bool(true, "Cancel if a candle closes beyond the opposite doji extreme", group = G_DJ)

// ---------- 7. Signal rules ----------
string G_SIG = "7. Signal rules"
string conflictRule = input.string(CONFLICT_SKIP, "If BUY and SELL qualify on the same candle", options = [CONFLICT_SKIP, CONFLICT_BUY, CONFLICT_SELL], group = G_SIG)
int    cooldownBars = input.int(0, "Min bars between signals in the same direction (0 = off)", minval = 0, group = G_SIG)

// ---------- 8. Display ----------
string G_DSP = "8. Display"
bool showMarkers   = input.bool(true, "Triangle markers", group = G_DSP)
bool showLabels    = input.bool(true, "BUY / SELL labels", group = G_DSP)
bool showPatName   = input.bool(true, "Pattern name in label", group = G_DSP)
bool showRsiVal    = input.bool(true, "RSI value in label", group = G_DSP)
bool showPatBox    = input.bool(true, "Highlight the pattern candles with a box", group = G_DSP)
bool colorSigBar   = input.bool(false, "Colour the signal candle", group = G_DSP)
bool showDojiSetup = input.bool(true, "Mark pending doji setups (not signals)", group = G_DSP)

// ---------- 9. alert() messages ----------
string G_AL = "9. Dynamic alerts (alert() function)"
bool alertBuyOn  = input.bool(true, "Send BUY via alert()", group = G_AL)
bool alertSellOn = input.bool(true, "Send SELL via alert()", group = G_AL)

// =====================================================================================
// Base series (all computed on every bar, outside conditional blocks)
// =====================================================================================
float atr      = ta.atr(atrLen)
float rsi      = ta.rsi(rsiSrc, rsiLen)
float emaVal   = ta.ema(close, emaLen)
float rng      = high - low
float body     = math.abs(close - open)
float bodyTop  = math.max(open, close)
float bodyBot  = math.min(open, close)
float bodyMid  = (open + close) / 2.0
float upWick   = high - bodyTop
float loWick   = bodyBot - low
bool  isBull   = close > open
bool  isBear   = close < open
float bodyAvg  = ta.sma(body, bodyAvgLen)
float lowestN  = ta.lowest(low, trendLen)
float highestN = ta.highest(high, trendLen)

int  warmup     = math.max(rsiLen, emaLen, atrLen, bodyAvgLen) + trendLen + 5
bool enoughBars = bar_index >= warmup
bool is1H       = timeframe.isminutes and timeframe.multiplier == 60
bool tfOk       = not restrictTo1H or is1H
bool prefixOk   = expectedPrefix == "" or syminfo.prefix == expectedPrefix

// =====================================================================================
// Trend context (price action, optional EMA)
// =====================================================================================
bool paDown    = close < close[trendLen] and lowestN < low[trendLen]
bool paUp      = close > close[trendLen] and highestN > high[trendLen]
bool downtrend = paDown and (not useEma or close < emaVal)
bool uptrend   = paUp and (not useEma or close > emaVal)
// Trend ending on the candle immediately BEFORE the pattern's first candle.
// Suffix = number of candles in the pattern.
bool dnBefore1 = downtrend[1]
bool dnBefore2 = downtrend[2]
bool dnBefore3 = downtrend[3]
bool upBefore1 = uptrend[1]
bool upBefore2 = uptrend[2]
bool upBefore3 = uptrend[3]
// Optional trend requirement for patterns that do not define it themselves
bool dnOpt1 = not trendForAll or dnBefore1
bool dnOpt2 = not trendForAll or dnBefore2
bool dnOpt3 = not trendForAll or dnBefore3
bool upOpt1 = not trendForAll or upBefore1
bool upOpt2 = not trendForAll or upBefore2
bool upOpt3 = not trendForAll or upBefore3

// =====================================================================================
// RSI events, lookback window and episodes
// =====================================================================================
bool osReading = rsi <= osLevel
bool obReading = rsi >= obLevel
bool osCross   = osReading and rsi[1] > osLevel
bool obCross   = obReading and rsi[1] < obLevel
bool osEvent   = rsiEventMode == RSI_READING ? osReading : osCross
bool obEvent   = rsiEventMode == RSI_READING ? obReading : obCross
int  bsOs      = ta.barssince(osEvent)
int  bsOb      = ta.barssince(obEvent)
int  rsiWindow = rsiTiming == TIMING_SAME ? 0 : rsiLookback
bool rsiBullOk = not na(bsOs) and bsOs <= rsiWindow
bool rsiBearOk = not na(bsOb) and bsOb <= rsiWindow

var int osEpisode   = 0
var int obEpisode   = 0
var int usedOsEp    = -1
var int usedObEp    = -1
if osReading and not osReading[1]
    osEpisode += 1
if obReading and not obReading[1]
    obEpisode += 1

// =====================================================================================
// Single-candle geometry (zero-range and zero-body safe: no divisions anywhere)
// =====================================================================================
bool hasRange     = rng > 0
bool rangeOk      = hasRange and (minRangeAtr <= 0 or rng >= minRangeAtr * atr)
bool isDoji       = hasRange and body <= dojiBodyPct / 100.0 * rng
bool isDragonfly  = isDoji and upWick <= djOppMaxPct / 100.0 * rng and loWick >= djLongMinPct / 100.0 * rng
bool isGravestone = isDoji and loWick <= djOppMaxPct / 100.0 * rng and upWick >= djLongMinPct / 100.0 * rng
bool isStdDoji    = isDoji and not isDragonfly and not isGravestone
bool isLongBody   = bodyAvg > 0 and body >= longBodyMult * bodyAvg
bool isSmallBody  = bodyAvg > 0 and body <= smallBodyMult * bodyAvg
// Hammer-family shapes exclude dojis, so body > 0 is guaranteed here
bool hammerShape  = hasRange and not isDoji and loWick >= hamLongMult * body and upWick <= hamShortMult * body
bool invHamShape  = hasRange and not isDoji and upWick >= hamLongMult * body and loWick <= hamShortMult * body
bool bullPinShape = hasRange and not isDoji and loWick >= pinNosePct / 100.0 * rng and body <= pinBodyPct / 100.0 * rng and (not pinProtrude or low < low[1])
bool bearPinShape = hasRange and not isDoji and upWick >= pinNosePct / 100.0 * rng and body <= pinBodyPct / 100.0 * rng and (not pinProtrude or high > high[1])
bool soldierBar   = isBull and body >= soldierBodyPct / 100.0 * rng and upWick <= soldierWickPct / 100.0 * rng
bool crowBar      = isBear and body >= soldierBodyPct / 100.0 * rng and loWick <= soldierWickPct / 100.0 * rng
float tweezerTol  = tolMethod == TOL_ATR ? tweezerAtrMult * atr : tweezerTicks * syminfo.mintick

// =====================================================================================
// Multi-candle shapes ([1] = previous completed candle, [2] = two candles back)
// =====================================================================================
bool bullEngulfShape = isBear[1] and isBull and open <= close[1] and close >= open[1] and body > body[1]
bool bearEngulfShape = isBull[1] and isBear and open >= close[1] and close <= open[1] and body > body[1]
bool tweezerBotShape = isBear[1] and isBull and math.abs(low - low[1]) <= tweezerTol
bool tweezerTopShape = isBull[1] and isBear and math.abs(high - high[1]) <= tweezerTol
bool piercingShape   = isBear[1] and isLongBody[1] and isBull and open <= close[1] and close >= close[1] + piercePct / 100.0 * body[1] and close < open[1]
bool darkCloudShape  = isBull[1] and isLongBody[1] and isBear and open >= close[1] and close <= close[1] - piercePct / 100.0 * body[1] and close > open[1]
bool bullHaramiShape = isBear[1] and isLongBody[1] and isBull and bodyTop <= open[1] and bodyBot >= close[1] and body <= haramiMaxRatio * body[1]
bool bearHaramiShape = isBull[1] and isLongBody[1] and isBear and bodyTop <= close[1] and bodyBot >= open[1] and body <= haramiMaxRatio * body[1]
bool morningShape    = isBear[2] and isLongBody[2] and isSmallBody[1] and bodyTop[1] <= bodyMid[2] and isBull and body > body[1] and close >= bodyMid[2]
bool eveningShape    = isBull[2] and isLongBody[2] and isSmallBody[1] and bodyBot[1] >= bodyMid[2] and isBear and body > body[1] and close <= bodyMid[2]
bool soldiersShape   = soldierBar[2] and soldierBar[1] and soldierBar and close[1] > close[2] and close > close[1] and open[1] >= open[2] and open[1] <= close[2] and open >= open[1] and open <= close[1]
bool crowsShape      = crowBar[2] and crowBar[1] and crowBar and close[1] < close[2] and close < close[1] and open[1] <= open[2] and open[1] >= close[2] and open <= open[1] and open >= close[1]
bool threeInUpShape  = bullHaramiShape[1] and isBull and close > open[2]
bool threeInDnShape  = bearHaramiShape[1] and isBear and close < open[2]
bool threeOutUpShape = bullEngulfShape[1] and isBull and close > close[1]
bool threeOutDnShape = bearEngulfShape[1] and isBear and close < close[1]

// =====================================================================================
// Non-doji patterns with their trend context (evaluated on the completion candle)
// =====================================================================================
bool pHammer     = enHammer and rangeOk and hammerShape and dnBefore1
bool pInvHammer  = enInvHammer and rangeOk and invHamShape and dnBefore1
bool pBullPin    = enBullPin and rangeOk and bullPinShape and dnOpt1
bool pBullEngulf = enBullEngulf and bullEngulfShape and dnOpt2
bool pTweezerBot = enTweezerBot and tweezerBotShape and dnOpt2
bool pPiercing   = enPiercing and piercingShape and dnOpt2
bool pBullHarami = enBullHarami and bullHaramiShape and dnOpt2
bool pMorning    = enMorningStar and morningShape and dnOpt3
bool pSoldiers   = enSoldiers and soldiersShape and dnOpt3
bool pThreeInUp  = enThreeInUp and threeInUpShape and dnOpt3
bool pThreeOutUp = enThreeOutUp and threeOutUpShape and dnOpt3

bool pShooting   = enShooting and rangeOk and invHamShape and upBefore1
bool pHangingMan = enHangingMan and rangeOk and hammerShape and upBefore1
bool pBearPin    = enBearPin and rangeOk and bearPinShape and upOpt1
bool pBearEngulf = enBearEngulf and bearEngulfShape and upOpt2
bool pTweezerTop = enTweezerTop and tweezerTopShape and upOpt2
bool pDarkCloud  = enDarkCloud and darkCloudShape and upOpt2
bool pBearHarami = enBearHarami and bearHaramiShape and upOpt2
bool pEvening    = enEveningStar and eveningShape and upOpt3
bool pCrows      = enCrows and crowsShape and upOpt3
bool pThreeInDn  = enThreeInDn and threeInDnShape and upOpt3
bool pThreeOutDn = enThreeOutDn and threeOutDnShape and upOpt3

// Deterministic priority: 3-candle > 2-candle > 1-candle patterns, then list order.
string bullName = ""
int    bullLen  = 0
if pThreeOutUp
    bullName := "Three Outside Up"
    bullLen  := 3
else if pThreeInUp
    bullName := "Three Inside Up"
    bullLen  := 3
else if pMorning
    bullName := "Morning Star"
    bullLen  := 3
else if pSoldiers
    bullName := "Three White Soldiers"
    bullLen  := 3
else if pBullEngulf
    bullName := "Bullish Engulfing"
    bullLen  := 2
else if pPiercing
    bullName := "Piercing Line"
    bullLen  := 2
else if pTweezerBot
    bullName := "Tweezer Bottom"
    bullLen  := 2
else if pBullHarami
    bullName := "Bullish Harami"
    bullLen  := 2
else if pHammer
    bullName := "Hammer"
    bullLen  := 1
else if pBullPin
    bullName := "Bullish Pin Bar"
    bullLen  := 1
else if pInvHammer
    bullName := "Inverted Hammer"
    bullLen  := 1

string bearName = ""
int    bearLen  = 0
if pThreeOutDn
    bearName := "Three Outside Down"
    bearLen  := 3
else if pThreeInDn
    bearName := "Three Inside Down"
    bearLen  := 3
else if pEvening
    bearName := "Evening Star"
    bearLen  := 3
else if pCrows
    bearName := "Three Black Crows"
    bearLen  := 3
else if pBearEngulf
    bearName := "Bearish Engulfing"
    bearLen  := 2
else if pDarkCloud
    bearName := "Dark Cloud Cover"
    bearLen  := 2
else if pTweezerTop
    bearName := "Tweezer Top"
    bearLen  := 2
else if pBearHarami
    bearName := "Bearish Harami"
    bearLen  := 2
else if pShooting
    bearName := "Shooting Star"
    bearLen  := 1
else if pBearPin
    bearName := "Bearish Pin Bar"
    bearLen  := 1
else if pHangingMan
    bearName := "Hanging Man"
    bearLen  := 1

// =====================================================================================
// Doji setups: created on the doji candle, signalled only on a LATER confirming candle
// =====================================================================================
bool gateOk = enoughBars and tfOk

bool bullDojiNow = gateOk and rangeOk and dnBefore1 and rsiBullOk and ((enDragonfly and isDragonfly) or (enDojiBull and isStdDoji))
bool bearDojiNow = gateOk and rangeOk and upBefore1 and rsiBearOk and ((enGravestone and isGravestone) or (enDojiBear and isStdDoji))

var int    bullDjBar  = na
var float  bullDjHigh = na
var float  bullDjLow  = na
var float  bullDjMid  = na
var string bullDjName = ""
var int    bullDjEp   = 0
var int    bearDjBar  = na
var float  bearDjHigh = na
var float  bearDjLow  = na
var float  bearDjMid  = na
var string bearDjName = ""
var int    bearDjEp   = 0

bool   bullDjConfirmed = false
string bullDjConfName  = ""
int    bullDjConfLen   = 0
int    bullDjConfEp    = 0
bool   bearDjConfirmed = false
string bearDjConfName  = ""
int    bearDjConfLen   = 0
int    bearDjConfEp    = 0

// Step 1: try to confirm / expire an existing setup (only on candles AFTER the doji)
if not na(bullDjBar) and bar_index > bullDjBar
    int   age    = bar_index - bullDjBar
    float level  = dojiConfRule == CONF_MID ? bullDjMid : bullDjHigh
    bool  colOk  = dojiConfRule == CONF_ANY or isBull
    if colOk and close > level
        bullDjConfirmed := true
        bullDjConfName  := bullDjName
        bullDjConfLen   := age + 1
        bullDjConfEp    := bullDjEp
        bullDjBar       := na
    else if (dojiCancelBrk and close < bullDjLow) or age >= dojiExpiry
        bullDjBar := na

if not na(bearDjBar) and bar_index > bearDjBar
    int   age    = bar_index - bearDjBar
    float level  = dojiConfRule == CONF_MID ? bearDjMid : bearDjLow
    bool  colOk  = dojiConfRule == CONF_ANY or isBear
    if colOk and close < level
        bearDjConfirmed := true
        bearDjConfName  := bearDjName
        bearDjConfLen   := age + 1
        bearDjConfEp    := bearDjEp
        bearDjBar       := na
    else if (dojiCancelBrk and close > bearDjHigh) or age >= dojiExpiry
        bearDjBar := na

// Step 2: register a new setup (a newer doji replaces an older pending one)
if bullDojiNow
    bullDjBar  := bar_index
    bullDjHigh := high
    bullDjLow  := low
    bullDjMid  := (high + low) / 2.0
    bullDjName := isDragonfly ? "Dragonfly Doji" : "Doji (bull)"
    bullDjEp   := osEpisode
if bearDojiNow
    bearDjBar  := bar_index
    bearDjHigh := high
    bearDjLow  := low
    bearDjMid  := (high + low) / 2.0
    bearDjName := isGravestone ? "Gravestone Doji" : "Doji (bear)"
    bearDjEp   := obEpisode

// =====================================================================================
// Final signals (only on CLOSED candles: barstate.isconfirmed)
// =====================================================================================
var int lastBuyBar  = na
var int lastSellBar = na

bool confirmedBar = barstate.isconfirmed
// A doji candle never triggers an immediate signal; it can only create a doji setup.
bool bullPatOk = bullName != "" and not isDoji and rsiBullOk and (not onePerEpisode or osEpisode != usedOsEp)
bool bearPatOk = bearName != "" and not isDoji and rsiBearOk and (not onePerEpisode or obEpisode != usedObEp)
bool bullDjOk  = bullDjConfirmed and (not onePerEpisode or bullDjConfEp != usedOsEp)
bool bearDjOk  = bearDjConfirmed and (not onePerEpisode or bearDjConfEp != usedObEp)
bool buyCool   = na(lastBuyBar) or bar_index - lastBuyBar > cooldownBars
bool sellCool  = na(lastSellBar) or bar_index - lastSellBar > cooldownBars
bool buyRaw    = confirmedBar and gateOk and buyCool and (bullPatOk or bullDjOk) and (not rsiExitFilter or rsi > osLevel)
bool sellRaw   = confirmedBar and gateOk and sellCool and (bearPatOk or bearDjOk) and (not rsiExitFilter or rsi < obLevel)
bool conflict   = buyRaw and sellRaw
bool buySignal  = buyRaw and (not conflict or conflictRule == CONFLICT_BUY)
bool sellSignal = sellRaw and (not conflict or conflictRule == CONFLICT_SELL)

string djBullTxt = bullDjConfName + " (confirmed)"
string djBearTxt = bearDjConfName + " (confirmed)"
string buyName  = bullPatOk and bullDjOk ? bullName + " + " + djBullTxt : bullPatOk ? bullName : bullDjOk ? djBullTxt : ""
string sellName = bearPatOk and bearDjOk ? bearName + " + " + djBearTxt : bearPatOk ? bearName : bearDjOk ? djBearTxt : ""
int    buyLen   = math.max(bullPatOk ? bullLen : 0, bullDjOk ? bullDjConfLen : 0)
int    sellLen  = math.max(bearPatOk ? bearLen : 0, bearDjOk ? bearDjConfLen : 0)

var string lastSignalTxt = "none yet"
if buySignal
    lastBuyBar := bar_index
    usedOsEp   := osEpisode
    lastSignalTxt := "BUY  " + buyName + "  @ " + str.tostring(close, format.mintick)
if sellSignal
    lastSellBar := bar_index
    usedObEp    := obEpisode
    lastSignalTxt := "SELL " + sellName + "  @ " + str.tostring(close, format.mintick)

// Low / high of all candles that belong to the signalling pattern (used for boxes and stops)
f_extremes(int n) =>
    float lo = low
    float hi = high
    if n > 1
        for i = 1 to n - 1
            lo := math.min(lo, low[i])
            hi := math.max(hi, high[i])
    [lo, hi]

[buyLo, buyHi]   = f_extremes(math.max(buyLen, 1))
[sellLo, sellHi] = f_extremes(math.max(sellLen, 1))

// =====================================================================================
// Chart display
// =====================================================================================
plotshape(showMarkers and buySignal, title = "BUY marker", style = shape.triangleup, location = location.belowbar, color = color.new(color.green, 0), size = size.small)
plotshape(showMarkers and sellSignal, title = "SELL marker", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0), size = size.small)
plotshape(showDojiSetup and bullDojiNow and confirmedBar, title = "Bullish doji setup (pending)", style = shape.diamond, location = location.belowbar, color = color.new(color.teal, 40), size = size.tiny)
plotshape(showDojiSetup and bearDojiNow and confirmedBar, title = "Bearish doji setup (pending)", style = shape.diamond, location = location.abovebar, color = color.new(color.maroon, 40), size = size.tiny)
plot(useEma and showEma ? emaVal : na, title = "Trend EMA", color = color.orange, linewidth = 1)
bgcolor(showTrendBg and downtrend ? color.new(color.red, 92) : showTrendBg and uptrend ? color.new(color.green, 92) : na, title = "Trend background")
barcolor(colorSigBar and buySignal ? color.lime : colorSigBar and sellSignal ? color.fuchsia : na, title = "Signal candle colour")
plot(rsi, title = "RSI value", display = display.data_window)
plot(buySignal ? 1 : sellSignal ? -1 : 0, title = "Signal direction", display = display.data_window)

f_labelText(string dir, string patName) =>
    string t = dir
    if showPatName
        t += "\n" + patName
    if showRsiVal
        t += "\nRSI " + str.tostring(rsi, "#.0")
    t

if buySignal and showLabels
    label.new(x = bar_index, y = buyLo - 0.5 * atr, text = f_labelText("BUY", buyName), xloc = xloc.bar_index, yloc = yloc.price, color = color.new(color.green, 0), style = label.style_label_up, textcolor = color.white, size = size.small)
if sellSignal and showLabels
    label.new(x = bar_index, y = sellHi + 0.5 * atr, text = f_labelText("SELL", sellName), xloc = xloc.bar_index, yloc = yloc.price, color = color.new(color.red, 0), style = label.style_label_down, textcolor = color.white, size = size.small)
if buySignal and showPatBox
    box.new(left = bar_index - math.max(buyLen, 1) + 1, top = buyHi, right = bar_index, bottom = buyLo, border_color = color.new(color.green, 20), bgcolor = color.new(color.green, 85))
if sellSignal and showPatBox
    box.new(left = bar_index - math.max(sellLen, 1) + 1, top = sellHi, right = bar_index, bottom = sellLo, border_color = color.new(color.red, 20), bgcolor = color.new(color.red, 85))

// Info / warning panel
var table infoT = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 15), border_color = color.gray, border_width = 1)
if showInfoPanel and barstate.islast
    string trendTxt = "Price action " + str.tostring(trendLen) + " bars" + (useEma ? " + EMA " + str.tostring(emaLen) : "")
    string stateTxt = downtrend ? "Downtrend" : uptrend ? "Uptrend" : "No trend"
    string pendTxt  = (na(bullDjBar) ? "" : "bull doji ") + (na(bearDjBar) ? "" : "bear doji")
    string tfWarn   = is1H ? "OK (1H)" : restrictTo1H ? "NOT 1H - signals OFF" : "NOT 1H - unvalidated"
    string pfWarn   = prefixOk ? syminfo.prefix : syminfo.prefix + " (expected " + expectedPrefix + ")"
    table.cell(infoT, 0, 0, "Symbol", text_color = color.white, text_size = size.small)
    table.cell(infoT, 1, 0, syminfo.tickerid, text_color = color.white, text_size = size.small)
    table.cell(infoT, 0, 1, "Broker prefix", text_color = color.white, text_size = size.small)
    table.cell(infoT, 1, 1, pfWarn, text_color = prefixOk ? color.white : color.orange, text_size = size.small)
    table.cell(infoT, 0, 2, "Timeframe", text_color = color.white, text_size = size.small)
    table.cell(infoT, 1, 2, timeframe.period + "  " + tfWarn, text_color = is1H ? color.white : color.orange, text_size = size.small)
    table.cell(infoT, 0, 3, "RSI(" + str.tostring(rsiLen) + ")", text_color = color.white, text_size = size.small)
    table.cell(infoT, 1, 3, str.tostring(rsi, "#.0"), text_color = osReading ? color.lime : obReading ? color.red : color.white, text_size = size.small)
    table.cell(infoT, 0, 4, "Trend filter", text_color = color.white, text_size = size.small)
    table.cell(infoT, 1, 4, trendTxt, text_color = color.white, text_size = size.small)
    table.cell(infoT, 0, 5, "Trend now", text_color = color.white, text_size = size.small)
    table.cell(infoT, 1, 5, stateTxt, text_color = color.white, text_size = size.small)
    table.cell(infoT, 0, 6, "Pending setups", text_color = color.white, text_size = size.small)
    table.cell(infoT, 1, 6, pendTxt == "" ? "none" : pendTxt, text_color = color.white, text_size = size.small)
    table.cell(infoT, 0, 7, "Last signal", text_color = color.white, text_size = size.small)
    table.cell(infoT, 1, 7, lastSignalTxt, text_color = color.white, text_size = size.small)
    table.cell(infoT, 0, 8, "History", text_color = color.white, text_size = size.small)
    table.cell(infoT, 1, 8, enoughBars ? str.tostring(bar_index + 1) + " bars" : "warming up", text_color = enoughBars ? color.white : color.orange, text_size = size.small)

// Dynamic alert() messages (fire once, after the candle has closed)
f_alertMsg(string dir, string patName) =>
    int closeT = na(time_close) ? time : time_close
    dir + " | " + syminfo.tickerid + " | TF " + timeframe.period + " | RSI(" + str.tostring(rsiLen) + ") " + str.tostring(rsi, "#.##") + " | Pattern: " + patName + " | Close " + str.tostring(close, format.mintick) + " | Candle close " + str.format_time(closeT, "yyyy-MM-dd HH:mm", syminfo.timezone) + " " + syminfo.timezone

if buySignal and alertBuyOn
    alert(f_alertMsg("BUY", buyName), alert.freq_once_per_bar_close)
if sellSignal and alertSellOn
    alert(f_alertMsg("SELL", sellName), alert.freq_once_per_bar_close)
// ======================= END OF SHARED SIGNAL ENGINE =======================

// =====================================================================================
// STRATEGY-ONLY: inputs
// =====================================================================================
string DIR_BOTH   = "Long & short"
string DIR_LONG   = "Long only"
string DIR_SHORT  = "Short only"
string SZ_PCT     = "Percent of equity"
string SZ_FIXED   = "Fixed quantity"
string SZ_RISK    = "Risk % of equity (uses stop distance)"
string SL_PATTERN = "Beyond pattern extreme (+ ATR buffer)"
string SL_ATR     = "ATR distance from signal close"
string TP_RR      = "Risk/reward multiple"
string TP_ATR     = "ATR multiple"
string TP_NONE    = "None (stop only)"

string G_ST = "10. Strategy - trades & sizing"
string tradeDir   = input.string(DIR_BOTH, "Trade direction", options = [DIR_BOTH, DIR_LONG, DIR_SHORT], group = G_ST)
bool   oneAtATime = input.bool(true, "One open position at a time (ignore signals while in a trade)", group = G_ST, tooltip = "If unticked, an opposite signal reverses the position, or only closes it when that direction is disabled.")
string sizing     = input.string(SZ_PCT, "Position sizing", options = [SZ_PCT, SZ_FIXED, SZ_RISK], group = G_ST)
float  pctEquity  = input.float(10.0, "Percent of equity (notional)", minval = 0.1, step = 1, group = G_ST)
float  fixedQty   = input.float(10.0, "Fixed quantity (symbol units)", minval = 0, group = G_ST)
float  riskPct    = input.float(1.0, "Risk % of equity per trade", minval = 0.01, step = 0.1, group = G_ST)
float  qtyStep    = input.float(0.01, "Quantity rounding step", minval = 0.000001, group = G_ST)

string G_RK = "11. Strategy - stop-loss & take-profit"
string slMethod    = input.string(SL_PATTERN, "Stop-loss method", options = [SL_PATTERN, SL_ATR], group = G_RK)
float  slAtrBuffer = input.float(0.1, "Pattern stop: ATR buffer (x ATR, 0 = exactly at the extreme)", minval = 0, step = 0.05, group = G_RK)
float  slAtrMult   = input.float(1.5, "ATR stop: distance (x ATR)", minval = 0.1, step = 0.1, group = G_RK)
string tpMethod    = input.string(TP_RR, "Take-profit method", options = [TP_RR, TP_ATR, TP_NONE], group = G_RK)
float  rrRatio     = input.float(2.0, "Risk/reward ratio (target = R x risk)", minval = 0.1, step = 0.1, group = G_RK)
float  tpAtrMult   = input.float(3.0, "ATR target: distance (x ATR)", minval = 0.1, step = 0.1, group = G_RK)
bool   recalcFill  = input.bool(true, "Re-anchor the R:R target to the actual fill price", group = G_RK, tooltip = "The first exit order uses the signal close. From the next candle on, the target is recomputed from strategy.position_avg_price; the stop stays where it was set.")

string G_DT = "12. Strategy - test window & reports"
bool useDateRange = input.bool(false, "Restrict entries to a date window", group = G_DT, tooltip = "Use this for chronological in-sample / out-of-sample tests.")
int  startDate    = input.time(timestamp("01 Jan 2020 00:00 +0000"), "Window start", group = G_DT)
int  endDate      = input.time(timestamp("31 Dec 2030 23:59 +0000"), "Window end", group = G_DT)
bool showStats    = input.bool(true, "Show summary statistics table", group = G_DT)
bool showPatStats = input.bool(true, "Show per-pattern statistics table", group = G_DT)

// =====================================================================================
// STRATEGY-ONLY: helpers
// =====================================================================================
f_qty(float entryPx, float stopPx) =>
    float pv  = syminfo.pointvalue
    float raw = sizing == SZ_FIXED ? fixedQty : sizing == SZ_PCT ? strategy.equity * pctEquity / 100.0 / (entryPx * pv) : strategy.equity * riskPct / 100.0 / (math.abs(entryPx - stopPx) * pv)
    math.floor(raw / qtyStep) * qtyStep

f_target(float basePx, float stopPx, bool isLong, float atrAtEntry) =>
    float risk = isLong ? basePx - stopPx : stopPx - basePx
    float tgt  = na
    if risk > 0
        if tpMethod == TP_RR
            tgt := isLong ? basePx + rrRatio * risk : basePx - rrRatio * risk
        else if tpMethod == TP_ATR
            tgt := isLong ? basePx + tpAtrMult * atrAtEntry : basePx - tpAtrMult * atrAtEntry
    tgt

// =====================================================================================
// STRATEGY-ONLY: order logic
// =====================================================================================
bool allowLong  = tradeDir != DIR_SHORT
bool allowShort = tradeDir != DIR_LONG
bool inWindow   = not useDateRange or (time >= startDate and time <= endDate)
bool inLong     = strategy.position_size > 0
bool inShort    = strategy.position_size < 0
bool isFlat     = strategy.position_size == 0

var float longStop  = na
var float shortStop = na
var float longAtr   = na
var float shortAtr  = na

// Keep the target anchored to the real fill once the position exists
if recalcFill and inLong and not na(longStop)
    strategy.exit("Long Exit", from_entry = "Long", stop = longStop, limit = f_target(strategy.position_avg_price, longStop, true, longAtr), comment_loss = "SL", comment_profit = "TP")
if recalcFill and inShort and not na(shortStop)
    strategy.exit("Short Exit", from_entry = "Short", stop = shortStop, limit = f_target(strategy.position_avg_price, shortStop, false, shortAtr), comment_loss = "SL", comment_profit = "TP")

float longStopCalc  = slMethod == SL_PATTERN ? buyLo - slAtrBuffer * atr : close - slAtrMult * atr
float shortStopCalc = slMethod == SL_PATTERN ? sellHi + slAtrBuffer * atr : close + slAtrMult * atr

if buySignal and inWindow
    bool canOpen = allowLong and (isFlat or (inShort and not oneAtATime))
    if canOpen and close - longStopCalc > 0
        float q = f_qty(close, longStopCalc)
        if q > 0
            longStop := longStopCalc
            longAtr  := atr
            strategy.entry("Long", strategy.long, qty = q, comment = buyName)
            strategy.exit("Long Exit", from_entry = "Long", stop = longStop, limit = f_target(close, longStop, true, atr), comment_loss = "SL", comment_profit = "TP")
    else if not allowLong and inShort and not oneAtATime
        strategy.close("Short", comment = "Opposite signal")

if sellSignal and inWindow
    bool canOpen = allowShort and (isFlat or (inLong and not oneAtATime))
    if canOpen and shortStopCalc - close > 0
        float q = f_qty(close, shortStopCalc)
        if q > 0
            shortStop := shortStopCalc
            shortAtr  := atr
            strategy.entry("Short", strategy.short, qty = q, comment = sellName)
            strategy.exit("Short Exit", from_entry = "Short", stop = shortStop, limit = f_target(close, shortStop, false, atr), comment_loss = "SL", comment_profit = "TP")
    else if not allowShort and inLong and not oneAtATime
        strategy.close("Long", comment = "Opposite signal")

if useDateRange and time > endDate and strategy.position_size != 0
    strategy.close_all(comment = "Test window ended")

// =====================================================================================
// STRATEGY-ONLY: extra statistics built from the closed-trade list
// (net of the commission and slippage set in Properties)
// =====================================================================================
var map<string, int>   patTrades = map.new<string, int>()
var map<string, int>   patWins   = map.new<string, int>()
var map<string, float> patNet    = map.new<string, float>()
var map<string, float> patGrossW = map.new<string, float>()
var map<string, float> patGrossL = map.new<string, float>()
var int   doneTrades = 0
var int   longN      = 0
var int   longW      = 0
var float longNet    = 0.0
var int   shortN     = 0
var int   shortW     = 0
var float shortNet   = 0.0
var float sumRetPct  = 0.0

while doneTrades < strategy.closedtrades
    int    k        = doneTrades
    string cmt      = strategy.closedtrades.entry_comment(k)
    string key      = cmt == "" ? "(no comment)" : cmt
    float  pnl      = strategy.closedtrades.profit(k)
    float  sz       = strategy.closedtrades.size(k)
    float  notional = math.abs(sz) * strategy.closedtrades.entry_price(k) * syminfo.pointvalue
    sumRetPct += notional > 0 ? pnl / notional * 100.0 : 0.0
    if sz > 0
        longN   += 1
        longW   += pnl > 0 ? 1 : 0
        longNet += pnl
    else
        shortN   += 1
        shortW   += pnl > 0 ? 1 : 0
        shortNet += pnl
    patTrades.put(key, nz(patTrades.get(key)) + 1)
    patWins.put(key, nz(patWins.get(key)) + (pnl > 0 ? 1 : 0))
    patNet.put(key, nz(patNet.get(key)) + pnl)
    patGrossW.put(key, nz(patGrossW.get(key)) + math.max(pnl, 0.0))
    patGrossL.put(key, nz(patGrossL.get(key)) + math.max(-pnl, 0.0))
    doneTrades += 1

f_cell(table t, int col, int row, string txt, color txtCol) =>
    table.cell(t, col, row, txt, text_color = txtCol, text_size = size.small, text_halign = text.align_left)

f_pct(float num, float den) =>
    den > 0 ? str.tostring(num / den * 100.0, "#0.0") + "%" : "n/a"

var table statsT = table.new(position.bottom_left, 2, 17, bgcolor = color.new(color.black, 15), border_color = color.gray, border_width = 1)
if showStats and barstate.islast
    int   n    = strategy.closedtrades
    float gp   = strategy.grossprofit
    float gl   = math.abs(strategy.grossloss)
    float np   = strategy.netprofit
    string cur = " " + syminfo.currency
    f_cell(statsT, 0, 0, "Backtest (net of costs)", color.yellow)
    f_cell(statsT, 1, 0, syminfo.tickerid + " " + timeframe.period, color.yellow)
    f_cell(statsT, 0, 1, "Closed trades", color.white)
    f_cell(statsT, 1, 1, str.tostring(n), color.white)
    f_cell(statsT, 0, 2, "Win / loss / even", color.white)
    f_cell(statsT, 1, 2, str.tostring(strategy.wintrades) + " / " + str.tostring(strategy.losstrades) + " / " + str.tostring(strategy.eventrades), color.white)
    f_cell(statsT, 0, 3, "Win rate", color.white)
    f_cell(statsT, 1, 3, f_pct(strategy.wintrades, n), color.white)
    f_cell(statsT, 0, 4, "Net profit", color.white)
    f_cell(statsT, 1, 4, str.tostring(np, "#,##0.00") + cur, np >= 0 ? color.lime : color.red)
    f_cell(statsT, 0, 5, "Net profit % of initial capital", color.white)
    f_cell(statsT, 1, 5, f_pct(np, strategy.initial_capital), np >= 0 ? color.lime : color.red)
    f_cell(statsT, 0, 6, "Gross profit", color.white)
    f_cell(statsT, 1, 6, str.tostring(gp, "#,##0.00") + cur, color.white)
    f_cell(statsT, 0, 7, "Gross loss", color.white)
    f_cell(statsT, 1, 7, str.tostring(gl, "#,##0.00") + cur, color.white)
    f_cell(statsT, 0, 8, "Profit factor", color.white)
    f_cell(statsT, 1, 8, gl > 0 ? str.tostring(gp / gl, "#0.00") : "n/a", color.white)
    f_cell(statsT, 0, 9, "Max equity drawdown", color.white)
    f_cell(statsT, 1, 9, str.tostring(strategy.max_drawdown, "#,##0.00") + cur, color.white)
    f_cell(statsT, 0, 10, "Avg winning trade", color.white)
    f_cell(statsT, 1, 10, strategy.wintrades > 0 ? str.tostring(gp / strategy.wintrades, "#,##0.00") + cur : "n/a", color.white)
    f_cell(statsT, 0, 11, "Avg losing trade", color.white)
    f_cell(statsT, 1, 11, strategy.losstrades > 0 ? str.tostring(-gl / strategy.losstrades, "#,##0.00") + cur : "n/a", color.white)
    f_cell(statsT, 0, 12, "Avg trade", color.white)
    f_cell(statsT, 1, 12, n > 0 ? str.tostring(np / n, "#,##0.00") + cur : "n/a", color.white)
    f_cell(statsT, 0, 13, "Avg trade return (% of notional)", color.white)
    f_cell(statsT, 1, 13, n > 0 ? str.tostring(sumRetPct / n, "#0.00") + "%" : "n/a", color.white)
    f_cell(statsT, 0, 14, "Long: trades / win% / net", color.white)
    f_cell(statsT, 1, 14, str.tostring(longN) + " / " + f_pct(longW, longN) + " / " + str.tostring(longNet, "#,##0.00"), color.white)
    f_cell(statsT, 0, 15, "Short: trades / win% / net", color.white)
    f_cell(statsT, 1, 15, str.tostring(shortN) + " / " + f_pct(shortW, shortN) + " / " + str.tostring(shortNet, "#,##0.00"), color.white)
    f_cell(statsT, 0, 16, "Open P/L", color.white)
    f_cell(statsT, 1, 16, str.tostring(strategy.openprofit, "#,##0.00") + cur, color.white)

var table patT = table.new(position.bottom_right, 5, 32, bgcolor = color.new(color.black, 15), border_color = color.gray, border_width = 1)
if showPatStats and barstate.islast
    f_cell(patT, 0, 0, "Pattern (entry)", color.yellow)
    f_cell(patT, 1, 0, "Trades", color.yellow)
    f_cell(patT, 2, 0, "Win %", color.yellow)
    f_cell(patT, 3, 0, "Net P/L", color.yellow)
    f_cell(patT, 4, 0, "PF", color.yellow)
    int row = 1
    for key in patTrades.keys()
        if row < 32
            int   nT = nz(patTrades.get(key))
            float gw = nz(patGrossW.get(key))
            float gl = nz(patGrossL.get(key))
            float nt = nz(patNet.get(key))
            f_cell(patT, 0, row, key, color.white)
            f_cell(patT, 1, row, str.tostring(nT), color.white)
            f_cell(patT, 2, row, f_pct(nz(patWins.get(key)), nT), color.white)
            f_cell(patT, 3, row, str.tostring(nt, "#,##0.00"), nt >= 0 ? color.lime : color.red)
            f_cell(patT, 4, row, gl > 0 ? str.tostring(gw / gl, "#0.00") : "n/a", color.white)
            row += 1

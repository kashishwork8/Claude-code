//@version=6
// =====================================================================================
// CFI WTI 1H · RSI(5) Candlestick Reversal — STRATEGY (backtest)
// -------------------------------------------------------------------------------------
// * Same signal engine as the indicator (the "SHARED SIGNAL ENGINE" block is identical).
// * Orders are market orders sent at the signal candle's close and filled by TradingView's
//   broker emulator at the NEXT candle's open (+ slippage), not at the signal close.
// * Initial capital, commission and slippage defaults below can be changed in
//   Settings -> Properties. Educational tool; a backtest does not guarantee future results.
// =====================================================================================
strategy("CFI WTI 1H RSI(5) Candlestick Reversal - Strategy", shorttitle = "WTI RSI5 Rev Strat", overlay = true, initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0, commission_type = strategy.commission.percent, commission_value = 0.0, slippage = 3, calc_on_every_tick = false, process_orders_on_close = false, max_labels_count = 500, max_boxes_count = 500)


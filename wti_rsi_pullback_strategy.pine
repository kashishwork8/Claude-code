//@version=6
strategy("WTI RSI(5) Pullback + EMA50 Trend", overlay=true,
     pyramiding=0,
     default_qty_type=strategy.cash, default_qty_value=10000,
     initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.0,
     process_orders_on_close=false, calc_on_every_tick=false)

// ── Inputs ──────────────────────────────────────────────
emaLen   = input.int(50, "EMA length", minval=1)
rsiLen   = input.int(5,  "RSI length", minval=1)
confBars = input.int(3, "Closes needed to confirm trend", minval=1)
rsiLow   = input.float(30, "RSI oversold level")
rsiHigh  = input.float(70, "RSI overbought level")
tpUsd    = input.float(2.0, "Take profit ($ price move)", step=0.1)
slUsd    = input.float(2.0, "Stop loss ($ price move)",   step=0.1)
useLongs  = input.bool(true, "Enable longs")
useShorts = input.bool(true, "Enable shorts")

// ── Indicators ──────────────────────────────────────────
ema = ta.ema(close, emaLen)
rsi = ta.rsi(close, rsiLen)

// Trend regime: confirmed after N consecutive closes that are on the right side of the EMA
// AND break the previous bar's extreme (up: close > prior high, down: close < prior low).
// It stays in force until N such closes in the other direction confirm a flip.
upClose   = close > ema and close > high[1]
downClose = close < ema and close < low[1]
aboveN = math.sum(upClose ? 1 : 0, confBars) == confBars
belowN = math.sum(downClose ? 1 : 0, confBars) == confBars
var int trend = 0
if aboveN
    trend := 1
else if belowN
    trend := -1

// ── Signals (evaluated on completed bar; fill at next bar's open) ──
// Uptrend  -> longs only:  RSI(5) <= 30 during pullback, then crosses back above 30
// Downtrend-> shorts only: RSI(5) >= 70 during rally,    then crosses back below 70
// Longs only in an uptrend, shorts only in a downtrend (never against the trend).
// Trend must hold on the extreme-RSI bar (previous bar) AND on the confirmation bar
longSignal  = barstate.isconfirmed and trend == 1  and trend[1] == 1  and ta.crossover(rsi, rsiLow)
shortSignal = barstate.isconfirmed and trend == -1 and trend[1] == -1 and ta.crossunder(rsi, rsiHigh)

flat = strategy.position_size == 0

if useLongs and longSignal and flat
    strategy.entry("Long", strategy.long)

if useShorts and shortSignal and flat
    strategy.entry("Short", strategy.short)

// ── Exits: fixed $ distance from actual average fill price ──
if strategy.position_size > 0
    strategy.exit("Long Exit", "Long",
         limit = strategy.position_avg_price + tpUsd,
         stop  = strategy.position_avg_price - slUsd)

if strategy.position_size < 0
    strategy.exit("Short Exit", "Short",
         limit = strategy.position_avg_price - tpUsd,
         stop  = strategy.position_avg_price + slUsd)

// ── Plots ───────────────────────────────────────────────
plot(ema, "EMA", color=trend == 1 ? color.green : trend == -1 ? color.red : color.gray, linewidth=2)
plotshape(longSignal  and flat and useLongs,  "Long",  shape.triangleup,   location.belowbar, color.green, size=size.tiny)
plotshape(shortSignal and flat and useShorts, "Short", shape.triangledown, location.abovebar, color.red,   size=size.tiny)
